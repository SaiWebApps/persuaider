# Copy to .env.local. Only these five matter for local development.

# Postgres. Local: `make db-up` starts one in Docker with exactly this URL.
DATABASE_URL="postgresql://persuaider:persuaider@localhost:5433/persuaider"
DATABASE_URL_UNPOOLED="postgresql://persuaider:persuaider@localhost:5433/persuaider"

# Clerk. Leave both empty to use Clerk keyless mode locally (the app prints a
# claim link on first run). Get real keys at https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Only needed in production, where Clerk -> database sync runs through the webhook.
CLERK_WEBHOOK_SECRET=""

# At least one LLM key. Order of preference: Anthropic, then Gemini, then OpenAI.
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional. Rate limiting is silently off without these.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
